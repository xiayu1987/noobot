{
  "name": "noobot-chat",
  "private": true,
  "version": "4.1.6",
  "type": "module",
  "exports": {
    "./plugin-api": "./src/public/index.js",
    "./plugin-api/ui": "./src/public/ui.js",
    "./plugin-api/chat-ui": "./src/public/chat-ui.js",
    "./plugin-api/locale": "./src/public/locale.js",
    "./plugin-api/attachment-domain": "./src/public/attachment-domain.js",
    "./plugin-api/session-domain": "./src/public/session-domain.js"
  },
  "scripts": {
    "generate:frontend-plugin-entries": "node scripts/generate-frontend-plugin-entries.mjs",
    "check:plugin-frontend-reverse-deps": "node scripts/check-plugin-frontend-reverse-deps.mjs",
    "check:frontend-structure": "node scripts/check-frontend-structure.mjs",
    "test:plugin-frontend-boundary-guard": "node --test scripts/check-plugin-frontend-reverse-deps.test.mjs",
    "prebuild": "npm run -s generate:frontend-plugin-entries",
    "dev": "vite",
    "build": "vite build",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "vitest",
    "test:e2e:protocol": "playwright test -c tests/e2e/protocol/playwright.protocol.config.js",
    "test:e2e:protocol:smoke": "playwright test -c tests/e2e/protocol/playwright.protocol.config.js --grep @smoke",
    "test:e2e:protocol:core": "playwright test -c tests/e2e/protocol/playwright.protocol.config.js --grep '@smoke|@core'",
    "test:e2e:protocol:full": "playwright test -c tests/e2e/protocol/playwright.protocol.config.js",
    "preview": "vite preview",
    "serve:caddy": "bash ./deploy/run-caddy.sh",
    "serve:caddy:restart": "bash ./deploy/restart-caddy.sh",
    "check:i18n-imports": "node ../../scripts/check-i18n-imports.mjs --project=client",
    "pretest": "npm run -s generate:frontend-plugin-entries && npm run -s check:frontend-structure && npm run -s check:plugin-frontend-reverse-deps && npm run -s test:plugin-frontend-boundary-guard && npm run -s check:i18n-imports"
  },
  "dependencies": {
    "@noobot/agent-transport-protocol": "file:../../agent-transport-protocol",
    "@noobot/attachment-protocol": "file:../../attachment-protocol",
    "@noobot/client-shared": "file:../shared",
    "@noobot/context-protocol": "file:../../context-protocol",
    "@noobot/plugin-runtime": "file:../../plugin-runtime",
    "@noobot/plugin-protocol": "file:../../plugin-protocol",
    "@noobot/session-protocol": "file:../../session-protocol",
    "@noobot/shared": "file:../../shared",
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.3",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "noobot-i18n": "file:../../i18n",
    "@noobot/event-protocol": "file:../../event-protocol"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "es-module-lexer": "^2.1.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "glob": "^13.0.6",
    "uuid": "^14.0.1"
  }
}
