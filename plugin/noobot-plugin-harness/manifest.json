{
  "id": "harness",
  "pluginKey": "harness",
  "name": "noobot-plugin-harness",
  "version": "4.1.4",
  "capabilities": [
    "agent.harness",
    "service.after_session_delete",
    "agent.register"
  ],
  "runtimeOptions": {
    "service.after_session_delete": {
      "enabled": true,
      "trace": false,
      "promptPolicy": false,
      "writeContextSnapshot": false,
      "writePrompts": false,
      "finalResponseGuard": false
    }
  },
  "apiVersion": "1",
  "entries": {
    "agent": "src/entries/agent.js",
    "service": "src/entries/service.js",
    "frontend": "frontend/index.js"
  },
  "frontend": {
    "apiVersion": "1",
    "authenticatedRoutePatterns": [
      "/api/internal/session/:userId/:sessionId/thinking-detail"
    ]
  },
  "enabledByDefault": true
}
