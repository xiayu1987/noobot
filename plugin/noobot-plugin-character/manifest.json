{
  "protocolVersion": 2,
  "id": "character",
  "name": "noobot-plugin-character",
  "version": "4.2.9",
  "description": "Import animated GLB characters and render LLM-generated animation protocols with Three.js.",
  "entries": {
    "agent": "src/entries/agent.js",
    "service": "src/entries/service.js",
    "frontend": "frontend/index.js"
  },
  "contributes": {
    "agent": {
      "hooks": {
        "registers": [
          { "id": "character-animation-context-before-llm-call", "point": "agent.before_llm_call" }
        ],
        "emits": []
      },
      "tools": [
        { "id": "character_animation_generate", "name": "character_animation_generate" },
        { "id": "character_animation_get", "name": "character_animation_get" },
        { "id": "character_animation_update", "name": "character_animation_update" },
        { "id": "character_animation_script", "name": "character_animation_script" },
        { "id": "character_camera_preset_list", "name": "character_camera_preset_list" },
        { "id": "character_animation_camera_apply", "name": "character_animation_camera_apply" }
      ]
    },
    "service": {
      "routes": [
        {
          "id": "character.asset.write",
          "method": "PUT",
          "paths": [
            "/internal/character/assets/:assetId",
            "/api/internal/character/assets/:assetId"
          ],
          "auth": "connected_user"
        },
        {
          "id": "character.asset.read",
          "method": "GET",
          "paths": [
            "/internal/character/assets/:assetId/:version",
            "/api/internal/character/assets/:assetId/:version"
          ],
          "auth": "connected_user"
        },
        {
          "id": "character.asset.commit",
          "method": "PUT",
          "paths": [
            "/internal/character/assets/:assetId/descriptor",
            "/api/internal/character/assets/:assetId/descriptor"
          ],
          "auth": "connected_user"
        },
        {
          "id": "character.asset.list",
          "method": "GET",
          "paths": ["/internal/character/assets", "/api/internal/character/assets"],
          "auth": "connected_user"
        },
        {
          "id": "character.asset.delete",
          "method": "DELETE",
          "paths": [
            "/internal/character/assets/:assetId",
            "/api/internal/character/assets/:assetId"
          ],
          "auth": "connected_user"
        }
      ]
    },
    "frontend": {
      "extensions": [
        { "id": "character-animation-projector", "point": "runtime.stream.route" },
        { "id": "character-session-artifact-hydrator", "point": "session.detail.hydrator" },
        { "id": "character-session-artifacts", "point": "session.artifact.panel" },
        { "id": "character-right-panel", "point": "right.tool.panel" },
        { "id": "character-more-actions", "point": "composer.more.actions" }
      ]
    }
  },
  "requires": {
    "ports": [
      "hooks.register",
      "tools.register",
      "artifacts.commit",
      "artifacts.get",
      "routes.bind",
      "service.workspace.assets",
      "authenticated_request",
      "frontend.contribute"
    ],
    "permissions": [
      "artifact.commit",
      "artifact.read",
      "workspace.asset.manage",
      "http.authenticated"
    ],
    "authenticatedRoutes": [
      { "method": "PUT", "path": "/api/internal/character/assets/:assetId" },
      { "method": "PUT", "path": "/api/internal/character/assets/:assetId/descriptor" },
      { "method": "GET", "path": "/api/internal/character/assets" },
      { "method": "GET", "path": "/api/internal/character/assets/:assetId/:version" },
      { "method": "DELETE", "path": "/api/internal/character/assets/:assetId" }
    ]
  },
  "configuration": {
    "defaults": { "enabled": true, "mode": "off", "selectedCharacterAssetIds": [] }
  },
  "enabledByDefault": true
}
