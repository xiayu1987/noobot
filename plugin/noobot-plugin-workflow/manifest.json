{
  "id": "workflow",
  "pluginKey": "workflow",
  "name": "noobot-plugin-workflow",
  "version": "4.1.4",
  "capabilities": [
    "agent.workflow",
    "service.after_session_delete",
    "service.http_routes",
    "bot.register"
  ],
  "runtimeOptions": {
    "service.after_session_delete": {
      "enabled": true,
      "mode": "on",
      "priority": 10,
      "timeoutMs": 5000
    },
    "service.http_routes": {
      "enabled": true,
      "mode": "on",
      "priority": 10
    }
  },
  "apiVersion": "1",
  "entries": {
    "agent": "src/entries/agent.js",
    "service": "src/entries/service.js",
    "frontend": "frontend/index.js"
  },
  "frontend": {
    "apiVersion": "1",
    "authenticatedRoutePatterns": [
      "/api/internal/workflow/session/:userId/:sessionId/:nodeDialogProcessId",
      "/api/internal/workflow/session/:userId/:sessionId/:nodeDialogProcessId/thinking-detail"
    ]
  },
  "enabledByDefault": true
}
