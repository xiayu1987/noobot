{
  "name": "noobot",
  "version": "4.4.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^24.21.0 || ^26.9.0",
    "npm": ">=12.0.2 <13"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "cpu-features": false,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "ssh2": false
  },
  "workspaces": [
    "platform-compatibility",
    "path-resolver",
    "runtime-topology-protocol",
    "hook-protocol",
    "agent-transport-protocol",
    "event-protocol",
    "connector-protocol",
    "connector-runtime",
    "connector-instances",
    "timeline-runtime",
    "attachment-protocol",
    "semantic-transfer-protocol",
    "session-protocol",
    "session-repair",
    "authoritative-state",
    "service",
    "agent",
    "agent-proxy",
    "model-proxy",
    "i18n",
    "shared",
    "plugin-protocol",
    "plugin-runtime",
    "workflow",
    "plugin/noobot-plugin-harness",
    "plugin/noobot-plugin-workflow",
    "plugin/noobot-plugin-character",
    "client/noobot-chat",
    "client/startup",
    "client/shared",
    "runtime-events",
    "context-protocol",
    "memory-protocol",
    "memory-repair",
    "workspace-protocol",
    "agent-config-protocol",
    "execution-isolation-protocol",
    "security-assessment-protocol",
    "file-mutation-protocol",
    "model-protocol",
    "model-runtime",
    "sanitize",
    "client/windows",
    "client/mac"
  ],
  "devDependencies": {
    "@vue/compiler-sfc": "3.5.44",
    "es-module-lexer": "^3.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.0",
    "espree": "^11.2.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.8",
    "vue": "3.5.44",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "lodash-es": "4.18.1"
  },
  "scripts": {
    "test:model-access": "node agent/scripts/model-access-test/start.js",
    "project:launcher": "node ./scripts/project-launcher.mjs",
    "release:version": "node ./scripts/bump-version.mjs",
    "release": "node ./scripts/release.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "node ./scripts/check-format.mjs",
    "check:quality": "npm run -s lint && npm run -s test:quality-config && npm run -s check:source-license-headers && npm run -s check:source-comments && npm run -s format:check && npm run -s check:legacy-time-keys && npm run -s check:duplication && npm run -s check:complexity-baseline && npm run -s check:fallback-chain-baseline && npm run -s check:unused-parameters-baseline && npm run -s check:file-effective-lines && npm run -s check:source-cycles && npm run -s check:empty-promise-catches && npm run -s check:i18n-imports && npm run -s check:parent-sessionid-unification && npm run -s check:plugin-i18n-keyset && npm run -s check:source-cjk-literals && npm run -s check:agent-plugin-decoupling && npm run -s check:numeric-literal-style && npm run -s check:shared-thresholds && npm run -s check:cross-platform-compat && npm run -s check:platform-compatibility-boundary && npm run -s check:workspace-runtime-dependencies && npm run -s check:workspace-module-extensions && npm run -s check:workspace-test-isolation && npm run -s check:semantic-transfer-protocol-fields && npm run -s check:attachment-protocol-fields && npm run -s check:message-identity-fields && npm run -s check:model-context-convergence && npm run -s check:agent-context-protocol-boundary && npm run -s check:agent-transport-protocol-boundary && npm run -s check:connector-protocol-boundary && npm run -s check:plugin-protocol-boundary && npm run -s check:agent-config-protocol-boundary && npm run -s check:execution-isolation-protocol-boundary && npm run -s check:security-assessment-protocol-boundary && npm run -s check:session-protocol-boundary && npm run -s check:runtime-port-literals && npm run -s check:bare-file-paths && npm run -s check:esm-import-extensions && npm run -s check:barrel-star-exports && npm run -s check:memory-protocol-boundary && npm run -s check:workspace-protocol-boundary && npm run -s check:tool-construction-protocol",
    "test:quality-config": "node --test \"scripts/**/*.test.mjs\"",
    "install:all": "npm install --workspaces",
    "build": "npm run -w client/startup build && npm run -w client/noobot-chat build",
    "check:legacy-time-keys": "node ./scripts/check-legacy-time-keys.mjs",
    "check:tool-construction-protocol": "node ./scripts/check-tool-construction-protocol.mjs",
    "check:duplication": "node ./scripts/check-duplication-baseline.mjs",
    "check:complexity-baseline": "node ./scripts/check-complexity-baseline.mjs",
    "check:fallback-chain-baseline": "node ./scripts/check-fallback-chain-baseline.mjs",
    "check:unused-parameters-baseline": "node ./scripts/check-unused-parameters-baseline.mjs",
    "check:file-effective-lines": "node ./scripts/check-file-effective-lines.mjs",
    "check:code-security": "eslint . --quiet",
    "check:source-cycles": "node ./scripts/check-source-cycles.mjs",
    "check:empty-promise-catches": "node ./scripts/check-empty-promise-catches.mjs",
    "dev:service": "npm run -w service dev",
    "dev:agent-proxy": "npm run -w agent-proxy dev",
    "dev:client": "npm run -w client/noobot-chat dev",
    "dev:windows": "npm run -w client/windows dev",
    "dev:mac": "npm run -w client/mac dev",
    "build:windows": "npm run -w client/windows build:win",
    "build:mac": "npm run -w client/mac build:mac",
    "test": "node ./scripts/run-with-failure-log.mjs npm run -s test:all",
    "test:all": "node --test runtime-topology-protocol/__tests__/ports.test.js && npm run --workspaces --if-present test",
    "test:e2e:execution-isolation": "npm run -w agent test:e2e:execution-isolation",
    "e2e:docker": "bash scripts/e2e-docker/run.sh",
    "check:i18n-imports": "node ./scripts/check-i18n-imports.mjs",
    "check:parent-sessionid-unification": "node ./scripts/check-parent-sessionid-unification.mjs",
    "check:workflow-dialog-process-static-guard": "node --test plugin/noobot-plugin-workflow/__tests__/core/workflow-dialog-process-static-guard.test.js",
    "check:plugin-i18n-keyset": "node ./scripts/check-plugin-i18n-keyset.mjs",
    "check:source-cjk-literals": "node ./scripts/check-source-cjk-literals.mjs",
    "check:agent-plugin-decoupling": "node ./scripts/check-agent-plugin-decoupling.mjs",
    "check:numeric-literal-style": "node ./scripts/check-numeric-literal-style.mjs",
    "check:shared-thresholds": "node ./scripts/check-shared-thresholds.mjs",
    "check:cross-platform-compat": "node ./scripts/check-cross-platform-compat.mjs",
    "check:platform-compatibility-boundary": "node ./scripts/check-platform-compatibility-boundary.mjs",
    "check:workspace-runtime-dependencies": "node ./scripts/check-workspace-runtime-dependencies.mjs",
    "check:workspace-module-extensions": "node ./scripts/check-workspace-module-extensions.mjs",
    "check:workspace-test-isolation": "node ./scripts/check-workspace-test-isolation.mjs",
    "check:semantic-transfer-protocol-fields": "node ./scripts/check-semantic-transfer-protocol-fields.mjs",
    "check:attachment-protocol-fields": "node ./scripts/check-attachment-protocol-fields.mjs",
    "check:message-identity-fields": "node ./scripts/check-message-identity-fields.mjs",
    "check:model-context-convergence": "node ./scripts/check-model-context-convergence.mjs",
    "audit:model-request-log": "node ./scripts/audit-model-request-log.mjs",
    "check:agent-context-protocol-boundary": "node ./scripts/check-agent-context-protocol-boundary.mjs",
    "check:agent-transport-protocol-boundary": "node ./scripts/check-agent-transport-protocol-boundary.mjs",
    "check:connector-protocol-boundary": "node ./scripts/check-connector-protocol-boundary.mjs",
    "check:plugin-protocol-boundary": "node ./scripts/check-plugin-protocol-boundary.mjs",
    "check:agent-config-protocol-boundary": "node ./scripts/check-agent-config-protocol-boundary.mjs",
    "check:execution-isolation-protocol-boundary": "node ./scripts/check-execution-isolation-protocol-boundary.mjs",
    "check:security-assessment-protocol-boundary": "node ./scripts/check-security-assessment-protocol-boundary.mjs",
    "check:session-protocol-boundary": "node ./scripts/check-session-protocol-boundary.mjs",
    "check:source-license-headers": "node ./scripts/check-source-license-headers.mjs",
    "check:source-comments": "node ./scripts/check-source-comments.mjs",
    "check:runtime-port-literals": "node ./scripts/check-runtime-port-literals.mjs",
    "check:bare-file-paths": "node ./scripts/check-bare-file-paths.mjs",
    "check:esm-import-extensions": "node ./scripts/check-esm-relative-import-extensions.mjs",
    "fix:esm-import-extensions": "node ./scripts/fix-esm-relative-import-extensions.mjs",
    "fix:source-license-headers": "node ./scripts/fix-source-license-headers.mjs",
    "check:barrel-star-exports": "node ./scripts/check-barrel-star-exports.mjs",
    "check:memory-protocol-boundary": "node ./scripts/check-memory-protocol-boundary.mjs",
    "check:workspace-protocol-boundary": "node ./scripts/check-workspace-protocol-boundary.mjs"
  }
}
