{
  "name": "noobot-agent",
  "version": "4.1.7",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./system-core": "./src/system-core/index.js",
    "./agent": "./src/runtime/index.js",
    "./bot-manage": "./src/bot/index.js",
    "./tools": "./src/tools/index.js",
    "./tools/connectors/connector-toolkit": "./src/tools/connectors/connector-toolkit.js",
    "./model": "./src/models/index.js",
    "./event": "./src/events/index.js",
    "./tracking": "./src/observability/index.js",
    "./connectors": "./src/integrations/connectors/index.js",
    "./constants": "./src/shared/constants/index.js",
    "./utils/fs-safe": "./src/shared/utils/fs-safe.js",
    "./utils/super-user": "./src/shared/utils/super-user.js",
    "./utils/shared-utils": "./src/shared/utils/shared-utils.js",
    "./utils/session-crypto": "./src/shared/utils/session-crypto.js",
    "./store": "./src/shared/storage/index.js",
    "./session": "./src/session/index.js",
    "./attach": "./src/artifacts/index.js",
    "./semantic-transfer": "./src/transfer-adapter/index.js",
    "./context": "./src/context/index.js",
    "./config": "./src/config/index.js",
    "./plugin": "./src/extensions/plugins/session-plugin-runtime-provider.js",
    "./application": "./src/application/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node -e \"import('./src/runtime/index.js').then(()=>console.log('ok')).catch(e=>{console.error(e);process.exit(1);})\"",
    "check:tools": "node -e \"import('./src/tools/index.js').then(()=>console.log('tools ok')).catch(e=>{console.error(e);process.exit(1);})\"",
    "check:api": "node -e \"Promise.all([import('./src/index.js'),import('./src/system-core/index.js'),import('./src/models/index.js'),import('./src/tools/index.js')]).then(()=>console.log('api ok')).catch(e=>{console.error(e);process.exit(1);})\"",
    "check:tool-schema": "node scripts/check-openai-tool-schema.js --userId admin",
    "check:tool-schema:live:gemini:admin": "node scripts/check-openai-tool-schema.js --live --model gemini_3_flash --userId admin",
    "test": "node --test --test-force-exit __tests__/**/*.test.js",
    "test:bot-manage": "node --test --test-force-exit __tests__/bot/*.test.js",
    "test:tools": "node --test --test-force-exit __tests__/tools/*.test.js",
    "test:utils": "node --test --test-force-exit __tests__/shared/utils/*.test.js __tests__/shared/utils/**/*.test.js",
    "test:connectors": "node --test --test-force-exit __tests__/integrations/connectors/*.test.js __tests__/integrations/connectors/**/*.test.js",
    "check:i18n-imports": "node ../scripts/check-i18n-imports.mjs --project=agent",
    "pretest": "npm run -s check:i18n-imports && npm run -s check:directory-boundaries",
    "check:directory-boundaries": "node scripts/check-directory-boundaries.mjs",
    "check:plugin-decoupling": "node ../scripts/check-agent-plugin-decoupling.mjs",
    "check:model-context-convergence": "node ../scripts/check-model-context-convergence.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.6",
    "@langchain/openai": "^1.5.7",
    "@noobot/authoritative-state": "file:../authoritative-state",
    "@noobot/attachment-protocol": "file:../attachment-protocol",
    "@noobot/semantic-transfer-protocol": "file:../semantic-transfer-protocol",
    "@noobot/context-protocol": "file:../context-protocol",
    "@noobot/agent-config-protocol": "file:../agent-config-protocol",
    "@noobot/model-protocol": "file:../model-protocol",
    "@noobot/model-runtime": "file:../model-runtime",
    "@noobot/hook-protocol": "file:../hook-protocol",
    "@noobot/runtime-events": "file:../runtime-events",
    "@noobot/sanitize": "file:../sanitize",
    "@noobot/session-protocol": "file:../session-protocol",
    "@noobot/session-repair": "file:../session-repair",
    "@noobot/shared": "file:../shared",
    "@vscode/ripgrep": "^1.18.0",
    "acorn": "^8.18.0",
    "noobot-i18n": "file:../i18n",
    "openai": "^7.4.0",
    "pino": "^10.3.1",
    "undici": "8.10.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "@noobot/plugin-runtime": "file:../plugin-runtime",
    "@noobot/plugin-protocol": "file:../plugin-protocol",
    "@noobot/path-resolver": "file:../path-resolver"
  },
  "optionalDependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "imapflow": "^1.7.0",
    "jsdom": "^30.0.1",
    "libreoffice": "^0.4.5",
    "libreoffice-convert": "^1.8.2",
    "mailparser": "^3.9.15",
    "mysql2": "^3.23.1",
    "node-poppler": "^10.0.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0"
  }
}
