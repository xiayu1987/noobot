{
  "name": "@noobot/session-protocol",
  "version": "4.4.4",
  "private": true,
  "type": "module",
  "description": "Canonical Noobot session aggregate, command, event and policy protocol",
  "exports": {
    "./runtime-event": "./src/runtime-event.js",
    ".": "./src/index.js",
    "./turn-lifecycle": "./src/turn-lifecycle.js",
    "./summary-checkpoint-storage": "./src/aggregate/summary-checkpoint-storage.js",
    "./package.json": "./package.json",
    "./execution-lifecycle": "./src/execution-lifecycle.js",
    "./execution-abort": "./src/lifecycle/execution-abort.js",
    "./execution-report": "./src/execution-report.js",
    "./execution-cancellation-scope": "./src/lifecycle/execution-cancellation-scope.js",
    "./turn-commit": "./src/turn-commit.js",
    "./turn-attachment-bind": "./src/turn-attachment-bind.js",
    "./turn-scope-identity": "./src/turn-scope-identity.js",
    "./turn-lookup-key": "./src/identity/turn-lookup-key.js",
    "./turn-command-id": "./src/lifecycle/turn-command-id.js",
    "./message-identity": "./src/identity/message-identity.js",
    "./message-identity-schema": "./src/identity/message-identity-schema.js",
    "./sessions-summary": "./src/aggregate/sessions-summary.js",
    "./session-detail": "./src/aggregate/session-detail.js",
    "./server-clock": "./src/aggregate/server-clock.js",
    "./session-mutation-response": "./src/aggregate/session-mutation-response.js",
    "./execution-event-index": "./src/aggregate/execution-event-index.js"
  },
  "scripts": {
    "test": "node ../scripts/run-with-isolated-tmp.mjs node --test __tests__/*.test.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noobot/shared": "file:../shared"
  }
}
