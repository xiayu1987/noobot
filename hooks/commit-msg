# Rejects commit messages that carry any Co-Authored-By trailer.
# Install: cp hooks/commit-msg .git/hooks/commit-msg
repo_root="$(git rev-parse --show-toplevel)" || exit 1
exec node "$repo_root/scripts/check-commit-message.mjs" "$1"
