{
  "name": "noobot-service",
  "version": "4.4.0",
  "type": "module",
  "imports": {
    "#agent/config": "./deps/agent-config.js",
    "#agent/bot": "./deps/agent-bot.js",
    "#agent/model": "./deps/agent-model.js",
    "#agent/tracking": "./deps/agent-tracking.js",
    "#agent/constants": "./deps/agent-constants.js",
    "#agent/utils": "./deps/agent-utils.js",
    "#agent/event": "./deps/agent-event.js",
    "#agent/plugin": "./deps/agent-plugin.js",
    "#agent/application": "./deps/agent-application.js"
  },
  "main": "app.js",
  "bin": {
    "noobot": "./bin/noobot.js"
  },
  "scripts": {
    "start": "node app.js",
    "cli": "node bin/noobot.js",
    "dev": "node --watch app.js",
    "test:bot": "npm --prefix ../agent run test:bot",
    "check:tool-schema:live:gemini:admin": "npm --prefix ../agent run check:tool-schema:live:gemini:admin",
    "init": "node scripts/init.js",
    "pm2:start": "PM2_HOME=../.pm2 npx pm2 start ../ecosystem.noobot.config.cjs --only noobot-service",
    "pm2:restart": "PM2_HOME=../.pm2 npx pm2 restart noobot-service",
    "pm2:stop": "PM2_HOME=../.pm2 npx pm2 stop noobot-service",
    "pm2:delete": "PM2_HOME=../.pm2 npx pm2 delete noobot-service",
    "pm2:logs": "PM2_HOME=../.pm2 npx pm2 logs noobot-service",
    "pm2:list": "PM2_HOME=../.pm2 npx pm2 list",
    "test": "node ../scripts/run-with-isolated-tmp.mjs node --test --test-force-exit --test-timeout=30000 \"__tests__/**/*.test.js\"",
    "test:tools": "npm --prefix ../agent run test:tools",
    "test:routes": "node ../scripts/run-with-isolated-tmp.mjs node --test --test-force-exit --test-timeout=30000 \"__tests__/routes/*.test.js\"",
    "lint:tools-constants": "eslint .",
    "lint:service-constants": "eslint .",
    "install:openvscode-server": "node scripts/install-openvscode-server.js",
    "ensure:openvscode-server": "node scripts/install-openvscode-server.js"
  },
  "dependencies": {
    "@noobot/agent-config-protocol": "file:../agent-config-protocol",
    "@noobot/attachment-protocol": "file:../attachment-protocol",
    "@noobot/connector-protocol": "file:../connector-protocol",
    "@noobot/context-protocol": "file:../context-protocol",
    "@noobot/connector-runtime": "file:../connector-runtime",
    "@noobot/connector-instances": "file:../connector-instances",
    "@noobot/hook-protocol": "file:../hook-protocol",
    "@noobot/model-protocol": "file:../model-protocol",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@noobot/agent-transport-protocol": "file:../agent-transport-protocol",
    "@noobot/authoritative-state": "file:../authoritative-state",
    "@noobot/session-protocol": "file:../session-protocol",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jscpd": "^5.4.1",
    "jsdom": "^30.1.2",
    "libreoffice": "^0.4.5",
    "node-poppler": "^11.0.0",
    "@noobot/shared": "file:../shared",
    "noobot-agent": "file:../agent",
    "noobot-i18n": "file:../i18n",
    "openai": "^7.33.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "pm2": "^7.0.4",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7",
    "@noobot/runtime-events": "file:../runtime-events",
    "@noobot/runtime-topology-protocol": "file:../runtime-topology-protocol",
    "@noobot/plugin-runtime": "file:../plugin-runtime",
    "@noobot/plugin-protocol": "file:../plugin-protocol",
    "@noobot/event-protocol": "file:../event-protocol",
    "@noobot/platform-compatibility": "file:../platform-compatibility",
    "@noobot/file-mutation-protocol": "file:../file-mutation-protocol",
    "@noobot/workspace-protocol": "file:../workspace-protocol",
    "@noobot/security-assessment-protocol": "file:../security-assessment-protocol"
  },
  "overrides": {
    "systeminformation": "^5.31.7"
  },
  "devDependencies": {
    "eslint": "^10.12.0"
  }
}
