{
  "workspace_root": "../workspace",
  "workspace_template_path": "../user-template/default-user",
  "default_provider": "gpt_5_6_sol",
  "multimodal": {
    "parsing": {
      "default_models": {
        "audio": "gemini_3_7_flash",
        "video": "gemini_3_7_flash",
        "image": "gpt_5_6_sol",
        "document": "gpt_5_6_sol"
      }
    },
    "generation": {
      "default_models": {
        "image": "gpt_image_2_5_flare"
      }
    }
  },
  "security": {
    "trusted_directories": ["*"],
    "execution_isolation": {
      "mode": "sandbox",
      "sandbox": {
        "provider": "docker",
        "scope": "user",
        "container_name": "noobot-workspace-sandbox",
        "image": "nikolaik/python-nodejs:python3.12-nodejs26-bookworm",
        "mounts": []
      }
    }
  },
  "tools": {
    "read_file": {
      "enabled": true
    },
    "write_file": {
      "enabled": true
    },
    "list_skills": {
      "enabled": true
    },
    "call_service": {
      "enabled": true
    },
    "call_mcp_task": {
      "enabled": true
    },
    "switch_model": {
      "enabled": true
    },
    "user_interaction": {
      "enabled": true
    },
    "execute_script": {
      "enabled": true
    },
    "execute_native_script": {
      "enabled": true
    },
    "access_connector": {
      "enabled": true
    },
    "web_search": {
      "enabled": true,
      "mode": "model_web_search",
      "model_web_search": {
        "model": "gpt_5_6_sol"
      },
      "search_engine": {
        "prompt": "优先用于补充实时或外部网页信息，优先关键词搜索，再精确搜索，最后再回答。",
        "endpoints": {
          "search": {
            "description": "搜索网页",
            "prompt": "返回可引用的检索结果摘要与来源。",
            "custom_param_format": "searx实例地址",
            "url": "${WEB_SEARCH_ENGINE_SEARCH_ADDRESS}",
            "query_string_format": "q=搜索内容",
            "body_format": "{}"
          }
        }
      }
    },
    "multimodal_generate": {
      "enabled": true
    },
    "task_summary": {
      "enabled": true
    },
    "help": {
      "enabled": true
    }
  },
  "scenarios": {
    "default": "full",
    "definitions": {
      "programming": {
        "model": "gpt_5_6_sol"
      },
      "text": {
        "model": "gpt_5_6_sol"
      }
    }
  },
  "plugins": {
    "harness": {
      "enabled": true,
      "mode": "on",
      "stepModels": {
        "planning": "gpt_5_6_sol",
        "guidance": "gpt_5_6_sol",
        "acceptance": "gpt_5_6_sol",
        "default": "gpt_5_6_sol"
      }
    },
    "workflow": {
      "enabled": true,
      "mode": "off",
      "semanticModel": "gpt_5_6_sol",
      "parallelNodeExecution": true
    },
    "character": {
      "enabled": true,
      "mode": "off"
    }
  },
  "preferences": {
    "language": "zh-CN"
  },
  "providers": {
    "claude_opus_5": {
      "enabled": true,
      "used_for_conversation": true,
