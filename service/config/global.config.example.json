{
  "workspace_root": "../workspace",
  "workspace_template_path": "../user-template/default-user",
  "default_provider": "gpt_5_6_sol",
  "multimodal": {
    "parsing": {
      "default_models": {
        "audio": "qwen3_5_omni_plus",
        "video": "qwen3_5_omni_plus",
        "image": "gpt_5_6_sol",
        "document": "gpt_5_6_sol"
      }
    },
    "generation": {
      "default_models": {
        "image": "gpt_5_6_sol"
      }
    }
  },
  "security": {
    "execution_isolation": {
      "mode": "sandbox",
      "sandbox": {
        "provider": "docker",
        "scope": "user",
        "container_name": "noobot-workspace-sandbox",
        "image": "nikolaik/python-nodejs:python3.12-nodejs26-bookworm",
        "mounts": []
      }
    }
  },
  "tools": {
    "read_file": {
      "enabled": true
    },
    "write_file": {
      "enabled": true
    },
    "list_skills": {
      "enabled": true
    },
    "call_service": {
      "enabled": true
    },
    "call_mcp_task": {
      "enabled": true
    },
    "delegate_task_async": {
      "enabled": true
    },
    "wait_async_task_result": {
      "enabled": true
    },
    "plan_multi_task_collaboration": {
      "enabled": true
    },
    "switch_model": {
      "enabled": true
    },
    "user_interaction": {
      "enabled": true
    },
    "execute_script": {
      "enabled": true
    },
    "execute_native_script": {
      "enabled": true
    },
    "access_connector": {
      "enabled": true
    },
    "web_search": {
      "enabled": true,
      "mode": "responses_api",
      "responses_api": {
        "model": "gpt_5_6_sol"
      },
      "search_engine": {
        "prompt": "优先用于补充实时或外部网页信息，优先关键词搜索，再精确搜索，最后再回答。",
        "endpoints": {
          "search": {
            "description": "搜索网页",
            "prompt": "返回可引用的检索结果摘要与来源。",
            "custom_param_format": "searx实例地址",
            "url": "${WEB_SEARCH_ENGINE_SEARCH_ADDRESS}",
            "query_string_format": "q=搜索内容",
            "body_format": "{}"
          }
        }
      }
    },
    "multimodal_generate": {
      "enabled": true
    },
    "task_summary": {
      "enabled": true
    },
    "request_help": {
      "enabled": true,
      "help_services": [],
      "help_model": ""
    }
  },
  "scenarios": {
    "default": "full",
    "definitions": {
      "programming": {
        "model": "gpt_5_6_sol"
      },
      "text": {
        "model": "gpt_5_6_sol"
      }
    }
  },
  "plugins": {
    "harness": {
      "enabled": true,
      "mode": "on",
      "stepModels": {
        "planning": "gpt_5_6_sol",
        "guidance": "gpt_5_6_sol",
        "acceptance": "gpt_5_6_sol",
        "default": "gpt_5_6_sol"
      }
    },
    "workflow": {
      "enabled": true,
      "mode": "off",
      "semanticModel": "gpt_5_6_sol",
      "parallelNodeExecution": true
    }
  },
  "preferences": {
    "language": "zh-CN"
  },
  "providers": {
    "claude_opus_4_8": {
      "enabled": true,
      "used_for_conversation": true,
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "${OPENAI_API_ADDRESS}",
      "model": "claude-opus-4-8",
      "format": "openai_compatible",
      "reasoning_effort": "medium",
      "tool_reasoning_effort": "medium",
      "description": "擅长编码",
      "multimodal_parsing": {
        "enabled": true,
        "input_modalities": ["image", "document"]
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": false,
          "support_scope": []
        }
      }
    },
    "gpt_5_4": {
      "enabled": true,
      "used_for_conversation": true,
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "${OPENAI_API_ADDRESS}",
      "model": "gpt-5.4",
      "format": "openai_compatible",
      "reasoning_effort": "medium",
      "tool_reasoning_effort": "medium",
      "description": "擅长编码",
      "multimodal_parsing": {
        "enabled": true,
        "input_modalities": ["image", "document"]
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": false,
          "support_scope": []
        }
      }
    },
    "gpt_5_5": {
      "enabled": true,
      "used_for_conversation": true,
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "${OPENAI_API_ADDRESS}",
      "model": "gpt-5.5",
      "format": "openai_compatible",
      "reasoning_effort": "medium",
      "tool_reasoning_effort": "medium",
      "description": "擅长编码",
      "multimodal_parsing": {
        "enabled": true,
        "input_modalities": ["image", "document"]
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": false,
          "support_scope": []
        }
      }
    },
    "gpt_5_6_sol": {
      "enabled": true,
      "used_for_conversation": true,
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "${OPENAI_API_ADDRESS}",
      "model": "gpt-5.6-sol",
      "format": "openai_compatible",
      "reasoning_effort": "medium",
      "tool_reasoning_effort": "medium",
      "description": "擅长编码",
      "capabilities": {
        "web_search": true
      },
      "multimodal_parsing": {
        "enabled": true,
        "input_modalities": ["image", "document"]
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": true,
          "support_scope": ["image"],
          "api_type": "openai_responses"
        }
      }
    },
    "nano_banana": {
      "enabled": true,
      "used_for_conversation": false,
      "api_key": "${OPENAI_API_KEY}",
      "base_url": "${OPENAI_API_ADDRESS}",
      "model": "nano-banana",
      "format": "openai_compatible",
      "reasoning_effort": "medium",
      "tool_reasoning_effort": "medium",
      "description": "擅长图片生成",
      "multimodal_parsing": {
        "enabled": false
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": true,
          "support_scope": ["image"],
          "api_type": "images_async"
        }
      }
    },
    "qwen3_5_omni_plus": {
      "enabled": true,
      "used_for_conversation": true,
      "api_key": "${DASHSCOPE_API_KEY}",
      "base_url": "${DASHSCOPE_API_ADDRESS}",
      "model": "qwen3.5-omni-plus",
      "format": "dashscope",
      "preserve_thinking": false,
      "description": "多模态解析",
      "multimodal_parsing": {
        "enabled": true,
        "input_modalities": ["image", "audio", "video"]
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": false,
          "support_scope": []
        }
      }
    },
    "GLM_5_1": {
      "enabled": true,
      "used_for_conversation": true,
      "api_key": "${DASHSCOPE_API_KEY}",
      "base_url": "${DASHSCOPE_API_ADDRESS}",
      "model": "ZHIPU/GLM-5.1",
      "format": "dashscope",
      "preserve_thinking": false,
      "description": "擅长通用对话、快速响应",
      "multimodal_parsing": {
        "enabled": false
      },
      "multimodal_generation": {
        "support_generation": {
          "enabled": false,
          "support_scope": []
        }
      }
    }
  },
  "services": {
    "weather_service": {
      "enabled": true,
      "api_key": "",
      "handler": "weather-service-handler",
      "prompt": "用于天气类查询，优先返回结构化天气信息。",
      "endpoints": {
        "get_weather": {
          "description": "天气查询",
          "prompt": "输入城市名，返回当前与未来天气。",
          "custom_param_format": "j1",
          "url": "https://wttr.in",
          "query_string_format": "{\"city\":\"\",\"format\":\"j1\"}",
          "body_format": "{}"
        }
      }
    }
  },
  "mcp_servers": {
    "china-railway": {
      "type": "sse",
      "description": "提供 12306购票信息查询等服务",
      "prompt": "用于铁路票务查询场景，先说明查询条件再调用。",
      "isActive": true,
      "name": "AliyunBailianMCP_china-railway",
      "baseUrl": "https://dashscope.aliyuncs.com/api/v1/mcps/china-railway/sse",
      "headers": {
        "Authorization": "Bearer ${DASHSCOPE_API_KEY_MCP}"
      }
    }
  },
  "streaming": true,
  "super_admin": {
    "user_id": "admin",
    "connect_code": "change-your-connect-code"
  }
}
